<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Throwaway probe screen for the offline map work. Debug builds only. -->
        <activity
            android:name="com.mistysteps.app.spike.MapSpikeActivity"
            android:exported="true"
            android:theme="@style/Theme.MistySteps" />
        <activity
            android:name="com.mistysteps.app.spike.MistyMapActivity"
            android:exported="true"
            android:theme="@style/Theme.MistySteps" />
        <!-- Moves the phone for testing: see MockLocationReceiver. Debug builds only. -->
        <receiver android:name="com.mistysteps.app.debug.MockLocationReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.potloodgum.mistysteps.debug.MOCK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
